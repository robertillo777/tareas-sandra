<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro Detallado de Usuario</title>
    <link rel="stylesheet" href="estilos.css">
</head>
<body>

    <header>
        <h1>Formulario de Registro de Usuario</h1>
        <nav>
            <a href="#informacion-personal">Personal</a>
            <a href="#informacion-contacto">Contacto</a>
            <a href="#informacion-cuenta">Cuenta</a>
            <a href="#preferencias">Preferencias</a>
            <button onclick="alert('¡Gracias por visitar!')">Inicio</button>
        </nav>
    </header>

    <main>
        <form id="registroFormulario" onsubmit="return validarFormulario(event)">
            
            <section id="informacion-personal">
                <h2>Información Personal y de Contacto</h2>

                <fieldset>
                    <legend>Datos Personales</legend>
                    
                    <label for="nombre">Nombre:</label>
                    <input type="text" id="nombre" name="nombre" required>
                    
                    <label for="apellido">Apellido:</label>
                    <input type="text" id="apellido" name="apellido" required>
                    
                    <label for="fechaNacimiento">Fecha de Nacimiento:</label>
                    <input type="date" id="fechaNacimiento" name="fechaNacimiento" required>
                    
                    <label>Género:</label>
                    <div class="radio-group">
                        <input type="radio" id="masculino" name="genero" value="Masculino" required>
                        <label for="masculino">Masculino</label>
                        
                        <input type="radio" id="femenino" name="genero" value="Femenino">
                        <label for="femenino">Femenino</label>
                        
                        <input type="radio" id="otro" name="genero" value="Otro">
                        <label for="otro">Otro</label>
                    </div>
                </fieldset>

                <fieldset id="informacion-contacto">
                    <legend>Datos de Contacto</legend>
                    
                    <label for="email">Dirección de Correo Electrónico:</label>
                    <input type="email" id="email" name="email" required>
                    
                    <label for="telefono">Número de Teléfono:</label>
                    <input type="tel" id="telefono" name="telefono" pattern="[0-9]{7,15}" required>
                    
                    <label for="direccion">Dirección:</label>
                    <textarea id="direccion" name="direccion" rows="4"></textarea>
                </fieldset>
            </section>

            <section>
                <h2 id="informacion-cuenta">Información de Cuenta y Preferencias</h2>

                <fieldset>
                    <legend>Datos de Cuenta</legend>
                    
                    <label for="usuario">Nombre de Usuario:</label>
                    <input type="text" id="usuario" name="usuario" required>
                    
                    <label for="contrasena">Contraseña:</label>
                    <input type="password" id="contrasena" name="contrasena" pattern="(?=.*\d)(?=.*[A-Z]).{8,}" title="Debe contener al menos 8 caracteres, incluyendo al menos una letra mayúscula y un número." required>
                    
                    <label for="confirmarContrasena">Confirmación de Contraseña:</label>
                    <input type="password" id="confirmarContrasena" name="confirmarContrasena" required>
                </fieldset>

                <fieldset id="preferencias">
                    <legend>Preferencias</legend>
                    
                    <label for="colorFavorito">Seleccionar un Color Favorito:</label>
                    <select id="colorFavorito" name="colorFavorito">
                        <option value="Rojo">Rojo</option>
                        <option value="Azul">Azul</option>
                        <option value="Verde">Verde</option>
                        <option value="Amarillo">Amarillo</option>
                    </select>

                    <div class="checkbox-group">
                        <input type="checkbox" id="terminos" name="terminos" required>
                        <label for="terminos">Aceptar Términos y Condiciones</label>
                    </div>
                </fieldset>

                <button type="submit">Registrarse</button>
            </section>
        </form>
    </main>

    <footer>
        <p>&copy; 2025 Formulario de Registro. Todos los derechos reservados.</p>
        <p>Desarrollado con HTML5, CSS y JavaScript.</p>
    </footer>

    <script src="validacion.js"></script>

</body>
</html>
